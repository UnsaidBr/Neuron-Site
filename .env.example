# DATABASE_URL: PostgreSQL connection string for Prisma ORM.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Optional custom base URL for API requests from the frontend client.
# In local development and single-container deployments, leave empty to use relative routes (/api/*).
VITE_API_URL=""

# Authentication (Admin Panel) - Server-side only (never prefix with VITE_)
# JWT_SECRET: Strong secret key (min 32 chars) for signing admin JWT session tokens.
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHAR_SECRET_KEY"

# INITIAL_ADMIN_EMAIL: Initial administrator email address for seeding.
INITIAL_ADMIN_EMAIL="admin@neuron.dcc.ufla.br"

# INITIAL_ADMIN_PASSWORD: Initial administrator password for seeding (hashed with bcrypt, never plain text).
INITIAL_ADMIN_PASSWORD="CHANGE_ME_INITIAL_STRONG_ADMIN_PASSWORD"

# INITIAL_ADMIN_NAME: Full name of the initial administrator/coordinator.
INITIAL_ADMIN_NAME="Coordenação NEURON"
